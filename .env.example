# --- SERVER CONFIGURATION ---
PORT=6081
NODE_ENV=production

# --- DATABASE ---
# ต้องชี้ไปที่ DB เดียวกับ admin dashboard (ใช้ตาราง room, room_booking, user ร่วมกัน)
# host 172.21.0.1 คือ gateway ของ network ที่ตรึงไว้ใน docker-compose.yml
DATABASE_URL=postgresql://smartbuilding_admin:CHANGE-ME@172.21.0.1:5432/smartbuilding

# --- AUTHENTICATION (Secrets) ---
JWT_ACCESS_SECRET=CHANGE-ME
JWT_REFRESH_SECRET=CHANGE-ME

# --- FRONTEND & PROXY CONFIG ---
VITE_API_BASE=https://55.sc.su.ac.th/booking/api
CLIENT_URL=https://55.sc.su.ac.th/booking

# --- IOT (ยังไม่ได้ใช้งานในโค้ดปัจจุบัน) ---
IOT_SERVICE_BASE_URL=https://55.sc.su.ac.th
