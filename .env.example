# --- SERVER CONFIGURATION ---
PORT=6081
NODE_ENV=production

# --- DATABASE (Supabase) ---
DATABASE_URL=postgresql://postgres:[password]@[db-host]:6543/postgres

# --- AUTHENTICATION (Secrets) ---
JWT_ACCESS_SECRET=your_super_secret_access_key_32_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_32_chars

# --- FRONTEND & PROXY CONFIG ---
# สำหรับรันบน Server ที่มี Nginx/Caddy เป็น Gateway (ผ่านพอร์ต 80)
# ตัวอย่าง: http://100.x.y.z/booking/api
VITE_API_BASE=http://<tailscale-ip>/booking/api
CLIENT_URL=http://<tailscale-ip>/booking

# --- IOT (Optional) ---
IOT_SERVICE_BASE_URL=